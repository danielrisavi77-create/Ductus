{
  "name": "ductus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test": "pnpm test:unit && pnpm test:property",
    "test:e2e": "playwright test",
    "prepare": "lefthook install",
    "test:integration": "vitest run --project integration",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v",
    "db:new": "dbmate new",
    "db:provision": "docker compose exec -T postgres psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/local/migrator.sql",
    "db:provision:app": "docker compose exec -T postgres psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/local/app-login.sql",
    "db:migrate": "pnpm db:provision && dbmate --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable&role=ductus_migrator\" --no-dump-schema --wait up && pnpm db:provision:app",
    "db:rollback": "dbmate --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable&role=ductus_migrator\" --no-dump-schema rollback",
    "db:status": "dbmate --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable\" status",
    "orch:status": "node scripts/orchestrator/pr-status.mjs",
    "orch:ready": "node scripts/orchestrator/pr-ready.mjs",
    "orch:push": "node scripts/orchestrator/push-verify.mjs",
    "orch:wait": "node scripts/orchestrator/wait-verdict.mjs",
    "test:db": "docker compose exec -T postgres pg_prove -U ductus -d ductus --recurse --ext .sql /db/tests",
    "agents:lint": "pnpm dlx --allow-build=agnix agnix@0.57.0 .",
    "tokens:report": "node scripts/engineering/token-report.mjs",
    "tokens:codeburn": "pnpm dlx codeburn@0.9.25 optimize"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-history": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "dexie": "^4.4.6",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cc-safety-net": "2.6.1",
    "dbmate": "^2.36.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "lefthook": "^2.1.16",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.28"
    }
  }
}
