{
  "name": "ductus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/engineering/eslint-cached.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:fake-oidc": "node --test infra/fake-oidc/accounts.test.mjs",
    "test": "pnpm test:unit && pnpm test:property && pnpm test:demo && pnpm test:fake-oidc",
    "test:e2e": "playwright test",
    "test:e2e:login": "playwright test --config playwright.login.config.ts",
    "test:demo:browser": "node --test scripts/demo/bootstrap-accounts.test.mjs",
    "test:skills": "node --test .claude/skills/run-ductus/process-command.test.mjs .agents/skills/run-ductus/process-command.test.mjs",
    "test:demo": "node --test db/local/psql-target.test.mjs scripts/demo/up.test.mjs scripts/demo/provision-teacher.test.mjs scripts/demo/login-e2e-evidence.test.mjs scripts/db/provision-auth.test.mjs scripts/demo/native/native.test.mjs",
    "prepare": "lefthook install",
    "test:integration": "vitest run --project integration",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v",
    "demo:up": "node scripts/demo/up.mjs",
    "demo:prepare": "node scripts/demo/up.mjs --prepare-only",
    "demo:up:native": "node scripts/demo/native/up.mjs",
    "demo:bootstrap-accounts": "node scripts/demo/bootstrap-accounts.mjs",
    "db:new": "dbmate new",
    "db:sum": "node scripts/engineering/migrations-ledger.mjs --write",
    "db:provision": "docker compose exec -T postgres psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/local/migrator.sql",
    "db:provision:app": "docker compose exec -T postgres psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/local/app-login.sql",
    "db:provision:auth": "node scripts/db/provision-auth.mjs",
    "db:seed": "docker compose exec -T postgres psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/local/seed.sql",
    "db:migrate": "pnpm db:provision && dbmate --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable&role=ductus_migrator\" --no-dump-schema --wait up && pnpm db:provision:app && pnpm db:provision:auth",
    "db:rollback": "dbmate --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable&role=ductus_migrator\" --no-dump-schema rollback",
    "db:status": "dbmate --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable\" status",
    "orch:status": "node scripts/orchestrator/pr-status.mjs",
    "orch:ready": "node scripts/orchestrator/pr-ready.mjs",
    "orch:push": "node scripts/orchestrator/push-verify.mjs",
    "orch:wait": "node scripts/orchestrator/wait-verdict.mjs",
    "orch:verdict": "node scripts/orchestrator/verdict.mjs",
    "orch:overlap": "node scripts/orchestrator/pr-overlap.mjs",
    "orch:clean": "node scripts/orchestrator/worktree-clean.mjs",
    "orch:health": "node scripts/orchestrator/health.mjs",
    "orch:metrics": "node scripts/orchestrator/pr-metrics.mjs",
    "orch:twin": "node scripts/orchestrator/ci-twin.mjs",
    "orch:capsule": "node scripts/orchestrator/failure-capsule.mjs",
    "orch:evidence": "node scripts/orchestrator/evidence.mjs",
    "orch:override": "node scripts/orchestrator/override-block.mjs",
    "orch:preflight": "node scripts/orchestrator/preflight.mjs",
    "test:db": "docker compose exec -T postgres pg_prove -U ductus -d ductus --recurse --ext .sql /db/tests",
    "agents:lint": "pnpm dlx --allow-build=agnix agnix@0.57.0 .",
    "tokens:report": "node scripts/engineering/token-report.mjs",
    "tokens:codeburn": "pnpm dlx codeburn@0.9.25 optimize",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --no-version-updates --disable-telemetry",
    "storybook:build": "storybook build --output-dir node_modules/.cache/storybook-static --disable-telemetry"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-history": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "dexie": "^4.4.6",
    "next": "15.5.28",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.63.0",
    "@smithy/signature-v4": "5.7.4",
    "@storybook/nextjs-vite": "10.6.3",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cc-safety-net": "2.6.1",
    "dbmate": "^2.36.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "lefthook": "^2.1.16",
    "storybook": "10.6.3",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.28"
    }
  }
}
