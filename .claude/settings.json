{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm run *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git reset --hard origin/main *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "PowerShell(git add -A *)",
      "PowerShell(git add -A)",
      "PowerShell(git add --all *)",
      "PowerShell(git add .)",
      "PowerShell(git add . *)",
      "PowerShell(git commit -a *)",
      "PowerShell(git commit -am *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push origin main)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.age)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/engineering/agent-hooks.mjs",
              "start"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/cleanup-worktrees.ps1\"",
            "async": true,
            "timeout": 180
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/engineering/agent-hooks.mjs",
              "budget"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/engineering/agent-hooks.mjs",
              "read"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/pr-metadata-precheck.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/pr-auto-merge.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "sales@knowledge-work-plugins": false,
    "marketing@knowledge-work-plugins": false,
    "finance@knowledge-work-plugins": false,
    "data@knowledge-work-plugins": false,
    "design@knowledge-work-plugins": false,
    "productivity@knowledge-work-plugins": false,
    "pdf-viewer@knowledge-work-plugins": false
  }
}
