{
  "rulebook_version": 1,
  "name": "ductus-rules",
  "version": "1.2.0",
  "description": "Ductus git rules from CLAUDE.md. Arguments are matched as whole tokens (short flags also inside a cluster), so the rules list every spelling they block. Not exhaustive: see docs/SESSIONS.md 4a.",
  "author": "Ductus",
  "allowed_commands": [
    "git"
  ],
  "rules": [
    {
      "name": "block-git-add-all",
      "command": "git",
      "subcommand": "add",
      "block_args": [
        "-A",
        "--a",
        "--al",
        "--all",
        "-u",
        "--u",
        "--up",
        "--upd",
        "--upda",
        "--updat",
        "--update",
        "--no-ignore-r",
        "--no-ignore-re",
        "--no-ignore-rem",
        "--no-ignore-remo",
        "--no-ignore-remov",
        "--no-ignore-remova",
        "--no-ignore-removal",
        ".",
        "./",
        ".\\",
        "./.",
        "..",
        "../",
        "..\\",
        ":/",
        ":(top)",
        "*",
        "**",
        "./*",
        ".\\*",
        ":/*"
      ],
      "reason": "CLAUDE.md: stage with 'git add <paths>', never a blanket add.",
      "intent": "use_alternative"
    },
    {
      "name": "block-git-stage-all",
      "command": "git",
      "subcommand": "stage",
      "block_args": [
        "-A",
        "--a",
        "--al",
        "--all",
        "-u",
        "--u",
        "--up",
        "--upd",
        "--upda",
        "--updat",
        "--update",
        "--no-ignore-r",
        "--no-ignore-re",
        "--no-ignore-rem",
        "--no-ignore-remo",
        "--no-ignore-remov",
        "--no-ignore-remova",
        "--no-ignore-removal",
        ".",
        "./",
        ".\\",
        "./.",
        "..",
        "../",
        "..\\",
        ":/",
        ":(top)",
        "*",
        "**",
        "./*",
        ".\\*",
        ":/*"
      ],
      "reason": "CLAUDE.md: stage with 'git add <paths>', never a blanket add.",
      "intent": "use_alternative"
    },
    {
      "name": "block-git-commit-all",
      "command": "git",
      "subcommand": "commit",
      "block_args": [
        "-a",
        "-am",
        "--all",
        ".",
        "./",
        ".\\",
        "./.",
        "..",
        "../",
        "..\\",
        ":/",
        ":(top)",
        "*",
        "**",
        "./*",
        ".\\*",
        ":/*"
      ],
      "reason": "CLAUDE.md: stage explicit paths with 'git add <paths>' before committing.",
      "intent": "use_alternative"
    },
    {
      "name": "block-git-commit-no-verify",
      "command": "git",
      "subcommand": "commit",
      "block_args": [
        "-n",
        "--no-v",
        "--no-ve",
        "--no-ver",
        "--no-veri",
        "--no-verif",
        "--no-verify"
      ],
      "reason": "Hooks run lint and the secrets scan; fix the failure instead of skipping them.",
      "intent": "stop_and_explain"
    },
    {
      "name": "block-git-push-no-verify",
      "command": "git",
      "subcommand": "push",
      "block_args": [
        "--no-v",
        "--no-ve",
        "--no-ver",
        "--no-veri",
        "--no-verif",
        "--no-verify"
      ],
      "reason": "CLAUDE.md: tests must be green before a push; do not skip the pre-push checks.",
      "intent": "stop_and_explain"
    },
    {
      "name": "block-git-push-force-with-lease",
      "command": "git",
      "subcommand": "push",
      "block_args": [
        "--force-w",
        "--force-wi",
        "--force-wit",
        "--force-with",
        "--force-with-",
        "--force-with-l",
        "--force-with-le",
        "--force-with-lea",
        "--force-with-leas",
        "--force-with-lease",
        "--force-i",
        "--force-if",
        "--force-if-",
        "--force-if-i",
        "--force-if-in",
        "--force-if-inc",
        "--force-if-incl",
        "--force-if-inclu",
        "--force-if-includ",
        "--force-if-include",
        "--force-if-includes"
      ],
      "reason": "Ductus branches are refreshed with a merge commit; no force push in any form.",
      "intent": "stop_and_explain"
    },
    {
      "name": "block-git-merge-no-verify",
      "command": "git",
      "subcommand": "merge",
      "block_args": [
        "--no-v",
        "--no-ve",
        "--no-ver",
        "--no-veri",
        "--no-verif",
        "--no-verify"
      ],
      "reason": "Do not skip the merge hooks; fix the failure instead.",
      "intent": "stop_and_explain"
    },
    {
      "name": "block-git-pull-no-verify",
      "command": "git",
      "subcommand": "pull",
      "block_args": [
        "--no-v",
        "--no-ve",
        "--no-ver",
        "--no-veri",
        "--no-verif",
        "--no-verify"
      ],
      "reason": "Do not skip the merge hooks; fix the failure instead.",
      "intent": "stop_and_explain"
    },
    {
      "name": "block-git-am-no-verify",
      "command": "git",
      "subcommand": "am",
      "block_args": [
        "-n",
        "-3n",
        "--no-v",
        "--no-ve",
        "--no-ver",
        "--no-veri",
        "--no-verif",
        "--no-verify"
      ],
      "reason": "Do not skip the commit hooks; fix the failure instead.",
      "intent": "stop_and_explain"
    },
    {
      "name": "block-git-rebase-no-verify",
      "command": "git",
      "subcommand": "rebase",
      "block_args": [
        "--no-v",
        "--no-ve",
        "--no-ver",
        "--no-veri",
        "--no-verif",
        "--no-verify"
      ],
      "reason": "Do not skip the pre-rebase hook; fix the failure instead.",
      "intent": "stop_and_explain"
    }
  ],
