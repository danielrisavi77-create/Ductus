# Local values for compose.yaml. Real secrets never go into the repo.
# Stack superuser: migrations, pgTAP and test fixtures only. The application
# refuses it (withActor accepts only a plain login that is a member of ductus_app).
DATABASE_URL=postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus
# Login of the web process, created by `pnpm db:migrate` (db/local/app-login.sql).
APP_DATABASE_URL=postgres://ductus_app_local:ductus-app-local-only@127.0.0.1:54329/ductus
# Login of the login callback (ductus_auth), created by `pnpm db:migrate`
# (db/local/auth-login.sql). No password lives in the repo: choose one of at
# least 16 characters, export it before `pnpm db:migrate`, and use the same
# value in AUTH_DATABASE_URL. The password must not contain a percent sign
# (`%`); the demo launcher rejects it.
DUCTUS_AUTH_LOCAL_PASSWORD=
AUTH_DATABASE_URL=postgres://ductus_auth_local:<DUCTUS_AUTH_LOCAL_PASSWORD>@127.0.0.1:54329/ductus
S3_ENDPOINT=http://127.0.0.1:9100
S3_ACCESS_KEY_ID=ductus-local
S3_SECRET_ACCESS_KEY=ductus-local-only
# Evidence storage domains (docs/BACKEND.md 4.1): one bucket per institution,
# with its identity label. `node db/local/evidence-storage-domain.mjs` (after
# `pnpm db:seed`, with the two variables below set) makes the local bucket of
# demo-fakultet and prints the EVIDENCE_STORAGE_DOMAINS line to put here (only
# for a web process started by hand, e.g. `pnpm dev`). `pnpm demo:up` does all
# of this itself and reads the process environment only, not `.env.local`
# (docs/DEMO-UP.md). The credential variables are the local compose store's own values.
EVIDENCE_S3_LOCAL_KEY_ID=ductus-local
EVIDENCE_S3_LOCAL_SECRET=ductus-local-only
EVIDENCE_STORAGE_DOMAINS=
# Development receipt signing key (docs/BACKEND.md 4.13 t. 7): the absolute
# path of a 32-byte seed file OUTSIDE the repository. Never commit the seed.
# `node db/local/evidence-signing-key.mjs` (after `pnpm db:seed`) makes the
# file if it is missing and registers its public key for demo-fakultet.
# Without the file, evidence ingest answers 503 (signing). Refused in production.
# For `pnpm demo:up` set it in the process environment before the run (not in
# `.env.local`); the default is ~/.ductus/demo-evidence-signing.seed.
DUCTUS_DEV_SIGNING_KEY_FILE=
MAILPIT_URL=http://127.0.0.1:8025
SMTP_URL=smtp://127.0.0.1:1025
# "Demo prijava": the fake provider is refused when NODE_ENV=production (D-09).
DUCTUS_AUTH_PROVIDER=fake-oidc
OIDC_ISSUER=http://localhost:8090
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_CLIENT_ID=ductus-local
OIDC_CLIENT_SECRET=ductus-local-only
